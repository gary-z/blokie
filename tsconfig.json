// Type checking for the JavaScript, without compiling any of it.
//
// Nothing here emits: `checkJs` turns on TypeScript's inference over ordinary
// .js files, and the types themselves are JSDoc comments. So the files that
// ship are the files in the repository, byte for byte -- which is the property
// the whole front end is built around. index.html loads modules straight off
// disk, the Pages workflow deploys by copying them, and sw.js precaches them by
// name. A build step between the source and the deployed site would be a fourth
// place for that list to go stale.
//
// This config covers the code that runs on the page. The files that run in a
// worker are checked by tsconfig.worker.json against a different set of
// globals, and the tests and tools by tsconfig.node.json against Node's;
// `npm run typecheck` runs all three.
//
// `strict` is on. It was off while the app was being brought under the checker,
// on the grounds that the engine and the page were written without types and
// passed as they were -- but what it was suppressing was mostly two things:
// parameters nothing had ever named a type for, and DOM lookups used without
// asking whether they found anything. Both are worth having. getElementById
// returning null is now handled in one place rather than assumed at nineteen
// call sites, and every function that crosses a boundary says what it takes.
{
  "compilerOptions": {
    // What the browsers this targets already have. No downlevelling
    // happens either way, since nothing is emitted.
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Nothing here should pick up ambient globals from an installed
    // package: the browser code gets exactly the globals named in `lib`
    // above, so a Node-only API used by mistake is reported rather than
    // quietly resolved.
    "types": [],

    "skipLibCheck": true,
    "strict": true
  },
  // Named one by one rather than globbed, because what belongs here is
  // exactly what the page loads. The Node-side tooling (test/, engine/tools/,
  // web/icons/) is checked by tsconfig.node.json instead, against Node's
  // globals rather than the browser's.
  "include": [
    "engine/js/blokie.js",
    "web/script.js",
    "web/storage.js",
    "web/sfx.js",
    "web/pwa.js"
  ]
}
