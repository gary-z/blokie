{
  "name": "blokie",
  "type": "module",
  "version": "1.0.0",
  "description": "A 9x9 block puzzle engine",
  "main": "engine/js/blokie.js",
  "exports": {
    ".": "./engine/js/blokie.js",
    "./wasm": "./engine/wasm/blokie-solver.wasm"
  },
  "files": [
    "engine/js/blokie.js",
    "engine/wasm/blokie-solver.js",
    "engine/wasm/blokie-solver.d.ts",
    "engine/wasm/blokie-solver.wasm"
  ],
  "homepage": "https://gary-z.github.io/blokie/",
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build:wasm": "bash engine/build-wasm.sh",
    "build:icons": "node web/icons/make-icons.js",
    "test:ai": "node test/engine/ai-plan-test.js",
    "test:bitboard": "node test/engine/bitboard-test.js",
    "test:enumeration": "node test/engine/enumeration-test.js",
    "test:placement": "node test/engine/placement-test.js",
    "test:fitness": "node test/engine/fitness-test.js",
    "test:storage": "node test/web/storage-test.js",
    "test:pwa": "node test/web/pwa-test.js",
    "test:performance": "node test/engine/performance-test.js",
    "compare:fitness": "node engine/tools/compare-fitness.js",
    "compare:probes": "node engine/tools/compare-probes.js",
    "analyze:probes": "node engine/tools/analyze-probes.js",
    "analyze:chains": "node engine/tools/analyze-chain-lengths.js"
  }
}
